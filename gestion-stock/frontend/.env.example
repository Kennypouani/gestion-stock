# ============================================================
# CONFIGURATION DU FRONTEND — copier en « .env » (jamais versionné)
# ============================================================

# Domaine public du site, sans slash final.
# C'est LE SEUL endroit à modifier pour changer de domaine : robots.txt
# et sitemap.xml sont générés à partir de cette valeur au build.
# Exemple : SITE_URL=https://stock-magasin.duckdns.org
SITE_URL=https://stock-magasin.duckdns.org

# URL de l'API si elle n'est pas servie sur la même origine que la page.
# Laisser vide pour appeler /api sur l'origine du site (recommandé).
# VITE_API_URL=https://api.monmagasin.ci/api

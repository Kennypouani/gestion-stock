# ============================================================
# MODÈLE DE PRODUCTION — à copier en backend/.env
#
#   cp backend/.env.production.example backend/.env
#   nano backend/.env        # remplacer chaque <...>
#   chmod 600 backend/.env
#
# `sudo ./deploiement/deploy.sh install` crée ce fichier pour vous
# s'il manque, puis s'arrête pour vous laisser le compléter.
#
# Ce fichier n'est JAMAIS versionné ni copié dans l'image Docker.
# Remplacez toutes les valeurs entre < > : deploy.sh refuse de
# démarrer tant qu'il en reste une.
# ============================================================

# --- Environnement ---
# production = réglages stricts : cookie Secure, comptes de
# démonstration désactivés, mots de passe forts exigés.
NODE_ENV=production

# Port interne de l'API (exposé seulement au conteneur web, jamais à l'hôte).
PORT=5000

# --- Adresse publique (SEUL endroit où changer de domaine) ---
# Sans slash final. Sert à trois choses :
#   • CORS (le frontend doit appeler depuis cette origine exacte) ;
#   • le domaine que Caddy certifie ;
#   • SITE_URL, donc robots.txt et sitemap.xml au build.
ORIGINE_FRONTEND=https://<votre-domaine>

# --- Reverse proxy ---
# Deux proxys s'empilent devant l'API : Caddy (hôte) puis Nginx
# (conteneur web). TRUST_PROXY=2 fait voir au serveur la vraie IP du
# visiteur pour la limitation des tentatives de connexion.
# Sans ce réglage, FORCER_HTTPS redirige en boucle.
TRUST_PROXY=2

# --- HTTPS obligatoire ---
# Redirection 308 de tout HTTP vers HTTPS + en-tête HSTS.
# Ne passer false que le temps d'un test HTTP sur le serveur.
FORCER_HTTPS=true
COOKIE_SECURE=true

# --- Sécurité des comptes ---
SECURITE_STRICTE=true
COMPTES_DEMO=false

# --- Données persistantes ---
# Volume monté par docker-compose (/app/donnees) : stock.db + sauvegardes/.
# En conteneur, ne pas modifier.
DOSSIER_DONNEES=/app/donnees

# --- Premier administrateur ---
# Créé au démarrage si la table des comptes est vide.
# Mot de passe : 12 caractères minimum, jamais un mot de passe de démo.
ADMIN_EMAIL=<votre-email-admin>
ADMIN_MOT_DE_PASSE=<mot-de-passe-de-12-caracteres-minimum>

# --- Services externes (facultatif) ---
# Toujours côté serveur : jamais de préfixe VITE_ (tout VITE_* est public).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================================
# CONFIGURATION DU SERVEUR — copier ce fichier en « .env »
# Le fichier .env ne doit JAMAIS être versionné ni partagé.
# ============================================================

# Environnement : "production" active les réglages stricts
# (cookie Secure, comptes de démonstration désactivés).
NODE_ENV=development

# Port d'écoute de l'API
PORT=5000

# Origine(s) du frontend autorisée(s) à appeler l'API,
# séparées par des virgules si plusieurs.
ORIGINE_FRONTEND=http://localhost:3000

# Nombre de proxies de confiance devant l'application.
# 1 si Nginx/Caddy est sur la même machine, vide sinon.
TRUST_PROXY=

# Cookie de session « Secure » (HTTPS obligatoire).
# Par défaut : true en production, false sinon.
COOKIE_SECURE=

# --- Comptes de démonstration ---
# Par défaut : créés hors production, jamais en production.
# COMPTES_DEMO=true
# MDP_DEMO_ADMIN=admin123
# MDP_DEMO_GERANT=gerant123
# MDP_DEMO_EMPLOYE=employe123

# --- Premier administrateur (obligatoire en production) ---
# Utilisé seulement si la table des comptes est vide et que
# les comptes de démonstration sont désactivés (12 caractères minimum).
# ADMIN_EMAIL=patron@monmagasin.ci
# ADMIN_MOT_DE_PASSE=

# --- Clés des services externes (paiement, e-mail…) ---
# Toujours côté serveur, jamais dans le frontend (pas de préfixe VITE_).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
